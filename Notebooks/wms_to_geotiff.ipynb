      "source": [
        "## Export with Different CRS\n",
        "\n",
        "You can also export in different coordinate reference systems. Here's an example using EPSG:3857 (Web Mercator).\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 32,
      "metadata": {
        "id": "JrFYN2g-R7vn",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 122
        },
        "outputId": "fbb165f1-e225-47d3-ceb5-f9a1aa9e3da4"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "Reading input: /tmp/aaf70a3f-8b76-4c4f-87d3-4c29c5d0a818.tif\n",
            "\n",
            "Adding overviews...\n",
            "Updating dataset tags...\n",
            "Writing output to: /content/Salvador_2006_ilha_mare.tif\n"
          ]
        },
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "'/content/Salvador_2006_ilha_mare.tif'"
            ],
            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "string"
            }
          },
          "metadata": {},
          "execution_count": 32
        }
      ],
      "source": [
        "# You can provide bbox in EPSG:4326 and output in EPSG:3857\n",
        "# The function will automatically transform the coordinates\n",
        "output3 = \"Salvador_2006_ilha_mare.tif\"\n",
        "common.wms_to_geotiff(\n",
        "    url=url,\n",
        "    layers=\"Salvador_2006\",\n",
        "    bbox=bbox,  # bbox in EPSG:4326\n",
        "    output=output3,\n",
        "    scale=1,  # 1 meters per pixel for projected CRS\n",
        "    bbox_crs=\"EPSG:4326\",  # Input bbox CRS (default)\n",
        "    output_crs=\"EPSG:31984\",  # Output CRS\n",
        "    quiet=True,\n",
        ")"
      ]
    },
