      "source": [
        "import rasterio\n",
        "from rasterio.plot import show\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Abre o arquivo GeoTIFF gerado anteriormente\n",
        "with rasterio.open('ilha_de_mare_.tif') as src:\n",
        "    # Plota a imagem diretamente\n",
        "    fig, ax = plt.subplots(figsize=(10, 8))\n",
        "    show(src, ax=ax, title=\"Visualização do GeoTIFF - Ilha de Maré\")\n",
        "    plt.show()"
      ],
