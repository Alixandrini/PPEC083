        "# Fazendo um laço de repetição para gerar imagens para toda a ilha de maré\n",
        "\n",
        "for j in range(2):\n",
        "  for i in range(7):\n",
        "    output = f\"ilha_de_mare_b{j}{i}.tif\"\n",
        "    # Export GeoTIFF with scale (degrees per pixel)\n",
        "    wms_2_geotif_(url, layers, bbox, output)\n",
        "    bbox[1]+=0.009\n",
        "    bbox[3]+=0.009\n",
        "  bbox = [-38.5428, -12.8036, -38.5256, -12.7944 ]\n",
        "  bbox[0]+=0.017\n",
        "  bbox[2]+=0.017"
      ]
    },
